#!/bin/sh
# Checks that no staged file is too big for an agent to read (check-size), and that the commit is
# formatted and builds. Cargo checks a copy of the staged files, not the files on disk:
# a new file that is on disk but not staged must not hide a commit that does not compile.
set -e
node "$HOME/www/home/tools/home.ts" check-size
root=$(git rev-parse --show-toplevel)
copy="$root/target/pre-commit/src"
rm -rf "$copy"
mkdir -p "$copy"
git checkout-index --all --prefix="$copy/"
cd "$copy"
cargo fmt --all --check || { echo "pre-commit: run cargo fmt, stage the result, and commit again." >&2; exit 1; }
CARGO_TARGET_DIR="$root/target/pre-commit/target" exec cargo check --workspace --quiet
